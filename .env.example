PORT=5000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated list of origins allowed to call this API. In production,
# set this to your actual frontend origin(s) — leaving CORS wide open
# (the previous behavior) lets any website make authenticated-looking
# requests against this API from a user's browser.
CORS_ORIGIN=http://new-kts-exam.duckdns.org,https://new-kts-exam.duckdns.org

# Optional -- only needed if the "Run" button on coding questions is used.
# Free signup at https://www.jdoodle.com
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
